---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import {
  LOCALE_METADATA,
  getTranslations,
  getAlternateLinks,
  switchLocalePath,
  type Locale,
} from '../i18n/config';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  currentPath: string;
  localeSwitchPath?: string;
  pageType?: 'website' | 'article';
  publishedTime?: string;
  noindex?: boolean;
}

const {
  locale,
  title,
  description,
  currentPath,
  localeSwitchPath,
  pageType = 'website',
  publishedTime,
  noindex = false,
} = Astro.props;

const t = getTranslations(locale);
const meta = LOCALE_METADATA[locale];

const pageTitle = title ? `${title} | ${t.brandName}` : t.siteTitle;
const pageDescription = description || t.siteDescription;

const siteOrigin = (Astro.site ? Astro.site.toString() : 'https://girish.ladestack.in').replace(/\/+$/, '');
const canonicalUrl = `${siteOrigin}${currentPath}`;
const alternateLinks = noindex ? [] : getAlternateLinks(currentPath, siteOrigin);
const defaultAlternateHref = `${siteOrigin}${switchLocalePath(currentPath, 'en')}`;

const isArticle = pageType === 'article';
const isBlogIndex = currentPath.includes('/blog') && !isArticle;

// Target short and long-tail keywords tailored to Girish Lade & LadeStack
const defaultKeywords = [
  'Girish Lade',
  'Girish Balaso Lade',
  'LadeStack',
  'UI/UX Designer',
  'Full-Stack Developer',
  'Pune Software Engineer',
  'Independent Product Builder',
  'Browser-First Web Utilities',
  'Privacy-First Web Apps',
  'Client-Side Computing',
  'GB Coder In-Browser IDE',
  'LS PDF Local Processing',
  'Bharat Land Converter',
  'Swift Resume ATS Builder',
  'LS Image Compressor WebP',
  'GameHub 33 Games',
  'LadeStack Drive Encrypted Storage',
  'BYOK AI App Builder',
  'WebAssembly Developer Tools',
  'Astro Multilingual Architecture',
  'TypeScript Solo Engineer',
].join(', ');

const articleSlugMatch = isArticle ? currentPath.match(/\/blog\/([^/]+)/) : null;
const articleSlug = articleSlugMatch ? articleSlugMatch[1] : '';
const ogImageUrl = isArticle && articleSlug
  ? `${siteOrigin}/api/og/${locale}/${articleSlug}.svg`
  : `${siteOrigin}/assets/aistudio/image_a475d35f.webp`;

// Comprehensive multi-entity Linked Schema.org Graph
const jsonLdGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteOrigin}/#website`,
      url: siteOrigin,
      name: 'Girish Lade · LadeStack',
      description: t.siteDescription,
      inLanguage: meta.htmlLang,
      publisher: {
        '@id': `${siteOrigin}/#organization`,
      },
    },
    {
      '@type': 'Organization',
      '@id': `${siteOrigin}/#organization`,
      name: 'LadeStack',
      url: 'https://ladestack.in',
      logo: `${siteOrigin}/favicon-32x32.png`,
      founder: {
        '@id': `${siteOrigin}/#person`,
      },
    },
    {
      '@type': 'Person',
      '@id': `${siteOrigin}/#person`,
      name: 'Girish Balaso Lade',
      alternateName: 'Girish Lade',
      jobTitle: 'Founder & Full-Stack Engineer',
      url: siteOrigin,
      image: `${siteOrigin}/assets/profile.jpeg`,
      sameAs: [
        'https://github.com/girishlade111',
        'https://www.linkedin.com/in/girish-lade/',
        'https://ladestack.in',
      ],
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumb`,
      itemListElement: isArticle
        ? [
            {
              '@type': 'ListItem',
              position: 1,
              name: t.nav.home,
              item: `${siteOrigin}/${locale}/`,
            },
            {
              '@type': 'ListItem',
              position: 2,
              name: t.nav.blog,
              item: `${siteOrigin}/${locale}/blog/`,
            },
            {
              '@type': 'ListItem',
              position: 3,
              name: title || pageTitle,
              item: canonicalUrl,
            },
          ]
        : isBlogIndex
          ? [
              {
                '@type': 'ListItem',
                position: 1,
                name: t.nav.home,
                item: `${siteOrigin}/${locale}/`,
              },
              {
                '@type': 'ListItem',
                position: 2,
                name: t.nav.blog,
                item: `${siteOrigin}/${locale}/blog/`,
              },
            ]
          : [
              {
                '@type': 'ListItem',
                position: 1,
                name: t.nav.home,
                item: `${siteOrigin}/${locale}/`,
              },
            ],
    },
    ...(isArticle
      ? [
          {
            '@type': 'BlogPosting',
            '@id': `${canonicalUrl}#article`,
            headline: pageTitle,
            description: pageDescription,
            inLanguage: meta.htmlLang,
            datePublished: publishedTime || '2026-11-01',
            dateModified: publishedTime || '2026-11-02',
            url: canonicalUrl,
            image: ogImageUrl,
            author: {
              '@id': `${siteOrigin}/#person`,
            },
            publisher: {
              '@id': `${siteOrigin}/#organization`,
            },
            mainEntityOfPage: {
              '@type': 'WebPage',
              '@id': canonicalUrl,
            },
            keywords: defaultKeywords,
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html lang={meta.htmlLang} class="overflow-x-clip">
  <head>
    <!-- Immediate Zero-Flash Theme Initialization -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var isDark = stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches);
          if (isDark) {
            document.documentElement.classList.add('dark');
            document.documentElement.setAttribute('data-theme', 'dark');
          } else {
            document.documentElement.classList.remove('dark');
            document.documentElement.setAttribute('data-theme', 'light');
          }
        } catch (_) {}
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Microsoft Clarity -->
    <script type="text/javascript" is:inline>
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "z8g8pciia9");
    </script>

    <!-- Critical Asset Preloading (Immediate parallel network fetch for LCP & FCP) -->
    <link
      rel="preload"
      as="image"
      href="/assets/aistudio/image_a475d35f.webp"
      type="image/webp"
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href="/assets/profile.jpeg"
      type="image/jpeg"
      fetchpriority="high"
    />

    <!-- Fonts: preconnect + preload as style + non-blocking stylesheet link -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@500;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@500;600;700&display=swap"
      />
    </noscript>
    <script is:inline>
      (function () {
        try {
          const desc = Object.getOwnPropertyDescriptor(window, 'fetch') || Object.getOwnPropertyDescriptor(Window.prototype, 'fetch');
          if (desc && desc.get && !desc.set && desc.configurable !== false) {
            let currentFetch = window.fetch.bind(window);
            Object.defineProperty(window, 'fetch', {
              configurable: true,
              enumerable: true,
              get: function () {
                return currentFetch;
              },
              set: function (fn) {
                if (typeof fn === 'function') currentFetch = fn;
              },
            });
          }
        } catch (_) {}

        window.addEventListener(
          'error',
          function (event) {
            const msg = String(event && event.message ? event.message : '');
            const file = String(event && event.filename ? event.filename : '');
            if (
              msg.includes('ResizeObserver loop') ||
              msg.includes('Cannot set property fetch') ||
              file.startsWith('chrome-extension://')
            ) {
              event.stopImmediatePropagation();
              event.preventDefault();
            }
          },
          true
        );
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={defaultKeywords} />
    <meta name="author" content="Girish Balaso Lade" />
    <meta name="creator" content="Girish Lade" />
    <meta name="publisher" content="LadeStack" />
    <meta name="theme-color" content="#fafafa" id="meta-theme-color" />
    <meta name="color-scheme" content="light dark" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Agentic AI Discovery (llmstxt.org & ARD) -->
    <link rel="alternate" type="text/markdown" href="/llms.txt" title="LLMs.txt" />
    <link rel="alternate" type="text/markdown" href="/llms-full.txt" title="Full LLMs.txt" />
    <link rel="help" type="text/markdown" href="/llms.txt" />
    <link rel="agent-catalog" type="application/json" href="/ai-catalog.json" />

    <!-- RSS 2.0 Feeds -->
    <link rel="alternate" type="application/rss+xml" title="Girish Lade — Full RSS 2.0 Feed" href="/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title={`Girish Lade — ${meta.label} RSS Feed`} href={`/${locale}/rss.xml`} />

    <!-- Canonical & Multilingual hreflang Alternates for SEO -->
    <link rel="canonical" href={canonicalUrl} />
    {
      alternateLinks.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }
    {!noindex && <link rel="alternate" hreflang="x-default" href={defaultAlternateHref} />}

    <!-- OpenGraph Metadata -->
    <meta property="og:type" content={pageType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={t.brandName} />
    <meta property="og:locale" content={meta.ogLocale} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    {
      alternateLinks
        .filter((alt) => alt.locale !== locale)
        .map((alt) => (
          <meta
            property="og:locale:alternate"
            content={LOCALE_METADATA[alt.locale].ogLocale}
          />
        ))
    }
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <!-- Twitter Card Metadata -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={pageTitle} />
    <meta name="twitter:creator" content="@girishlade" />

    <!-- Schema.org JSON-LD Structured Data (Linked Graph) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdGraph)} />
  </head>
  <body class="min-h-screen flex flex-col overflow-x-clip bg-[#fafafa] text-zinc-900 antialiased selection:bg-zinc-900 selection:text-white dark:bg-[#09090b] dark:text-zinc-100 dark:selection:bg-zinc-100 dark:selection:text-zinc-900 transition-colors duration-150">
    <Navbar locale={locale} currentPath={currentPath} localeSwitchPath={localeSwitchPath} />
    <main id="main-content" class="flex-1 min-w-0 w-full max-w-3xl mx-auto px-3.5 sm:px-6">
      <slot />
    </main>
    <Footer locale={locale} currentPath={currentPath} />
  </body>
</html>
