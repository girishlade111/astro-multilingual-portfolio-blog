---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import {
  LOCALE_METADATA,
  getTranslations,
  getAlternateLinks,
  switchLocalePath,
  type Locale,
} from '../i18n/config';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  currentPath: string;
  pageType?: 'website' | 'article';
  publishedTime?: string;
}

const {
  locale,
  title,
  description,
  currentPath,
  pageType = 'website',
  publishedTime,
} = Astro.props;

const t = getTranslations(locale);
const meta = LOCALE_METADATA[locale];

const pageTitle = title ? `${title} | ${t.brandName}` : t.siteTitle;
const pageDescription = description || t.siteDescription;

const siteOrigin = (Astro.site ? Astro.site.toString() : 'http://localhost:3000').replace(/\/+$/, '');
const canonicalUrl = `${siteOrigin}${currentPath}`;
const alternateLinks = getAlternateLinks(currentPath, siteOrigin);
const defaultAlternateHref = `${siteOrigin}${switchLocalePath(currentPath, 'en')}`;

const jsonLd =
  pageType === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: pageTitle,
        description: pageDescription,
        inLanguage: meta.htmlLang,
        datePublished: publishedTime || '2026-11-01',
        url: canonicalUrl,
        mainEntityOfPage: {
          '@type': 'WebPage',
          '@id': canonicalUrl,
        },
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: t.siteTitle,
        description: pageDescription,
        inLanguage: meta.htmlLang,
        url: canonicalUrl,
      };
---

<!doctype html>
<html lang={meta.htmlLang} class="overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (function () {
        try {
          const desc = Object.getOwnPropertyDescriptor(window, 'fetch') || Object.getOwnPropertyDescriptor(Window.prototype, 'fetch');
          if (desc && desc.get && !desc.set && desc.configurable !== false) {
            let currentFetch = window.fetch.bind(window);
            Object.defineProperty(window, 'fetch', {
              configurable: true,
              enumerable: true,
              get: function () {
                return currentFetch;
              },
              set: function (fn) {
                if (typeof fn === 'function') currentFetch = fn;
              },
            });
          }
        } catch (_) {}

        window.addEventListener(
          'error',
          function (event) {
            const msg = String(event && event.message ? event.message : '');
            const file = String(event && event.filename ? event.filename : '');
            if (
              msg.includes('ResizeObserver loop') ||
              msg.includes('Cannot set property fetch') ||
              file.startsWith('chrome-extension://')
            ) {
              event.stopImmediatePropagation();
              event.preventDefault();
            }
          },
          true
        );
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts: preconnect + stylesheet link instead of a blocking CSS @import -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@500;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@500;600;700&display=swap"
      />
    </noscript>

    <!-- High-priority preload for Lanyard profile image & Hero background so they are ready at t=0ms -->
    <link
      rel="preload"
      as="image"
      href="/assets/aistudio/profile_34f4dafb.webp"
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href="/assets/aistudio/image_a475d35f.webp"
      fetchpriority="high"
    />

    <!-- Canonical & Multilingual hreflang Alternates for SEO -->
    <link rel="canonical" href={canonicalUrl} />
    {
      alternateLinks.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={defaultAlternateHref} />

    <!-- OpenGraph Metadata -->
    <meta property="og:type" content={pageType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={t.brandName} />
    <meta property="og:locale" content={meta.ogLocale} />
    {
      alternateLinks
        .filter((alt) => alt.locale !== locale)
        .map((alt) => (
          <meta
            property="og:locale:alternate"
            content={LOCALE_METADATA[alt.locale].ogLocale}
          />
        ))
    }
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <!-- Twitter Card Metadata -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />

    <!-- Schema.org JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen flex flex-col overflow-x-hidden bg-[#fafafa] text-zinc-900 antialiased selection:bg-zinc-900 selection:text-white">
    <Navbar locale={locale} currentPath={currentPath} />
    <main class="flex-1 w-full max-w-3xl mx-auto px-3.5 sm:px-6">
      <slot />
    </main>
    <Footer locale={locale} currentPath={currentPath} />
  </body>
</html>
