---
import { getRelativeLocaleUrl } from 'astro:i18n';
import {
  LOCALES,
  LOCALE_METADATA,
  getTranslations,
  switchLocalePath,
  extractSubPath,
  type Locale,
} from '../i18n/config';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const t = getTranslations(locale);
const subPath = extractSubPath(currentPath);
const isHome = subPath === '/';
const isBlog = subPath.startsWith('/blog');

const homeUrl = getRelativeLocaleUrl(locale, '');
const blogUrl = getRelativeLocaleUrl(locale, 'blog');
---

<header class="sticky top-0 z-40 bg-[#fafafa]/90 backdrop-blur-md border-b border-zinc-200/70">
  <div class="max-w-3xl mx-auto flex items-center justify-between gap-2 px-3.5 sm:px-6 h-12 sm:h-14">
    <!-- Zone 1: Minimal Brand Wordmark -->
    <a
      href={homeUrl}
      class="font-display text-sm sm:text-base font-bold tracking-tight text-zinc-950 hover:text-zinc-700 transition-colors whitespace-nowrap shrink-0"
    >
      {t.brandName}
    </a>

    <!-- Zone 2: Compact Home & Blog Links -->
    <nav
      aria-label="Primary Navigation"
      class="flex items-center gap-4 sm:gap-6 text-xs sm:text-sm font-medium text-zinc-500"
    >
      <a
        href={homeUrl}
        aria-current={isHome ? 'page' : undefined}
        class={`inline-flex items-center h-8 px-1 transition-colors whitespace-nowrap shrink-0 ${
          isHome
            ? 'text-zinc-950 font-semibold underline underline-offset-4 decoration-zinc-950 decoration-1.5'
            : 'hover:text-zinc-950'
        }`}
      >
        {t.nav.home}
      </a>
      <a
        href={blogUrl}
        aria-current={isBlog ? 'page' : undefined}
        class={`inline-flex items-center h-8 px-1 transition-colors whitespace-nowrap shrink-0 ${
          isBlog
            ? 'text-zinc-950 font-semibold underline underline-offset-4 decoration-zinc-950 decoration-1.5'
            : 'hover:text-zinc-950'
        }`}
      >
        {t.nav.blog}
      </a>
    </nav>

    <!-- Zone 3: Modern Accessible Language Dropdown (Untitled UI / React Aria pattern) -->
    <div class="relative shrink-0" id="language-dropdown-root">
      <button
        type="button"
        id="language-dropdown-trigger"
        aria-haspopup="listbox"
        aria-expanded="false"
        aria-controls="language-dropdown-popover"
        aria-label={`${t.nav.languageLabel} (${locale.toUpperCase()})`}
        class="group inline-flex items-center gap-1.5 h-8 px-2.5 rounded-lg border border-zinc-200/90 bg-white hover:border-zinc-300 hover:bg-zinc-50/80 text-zinc-700 text-xs font-medium shadow-2xs transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-zinc-900 focus-visible:ring-offset-1 cursor-pointer"
      >
        <!-- Translation Icon -->
        <svg
          aria-hidden="true"
          class="w-3.5 h-3.5 text-zinc-700 shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m5 8 6 6" />
          <path d="m4 14 6-6 2-3" />
          <path d="M2 5h12" />
          <path d="M7 2h1" />
          <path d="m22 22-5-10-5 10" />
          <path d="M14 18h6" />
        </svg>

        <span class="font-mono text-[11px] font-semibold text-zinc-900 uppercase tracking-wide">
          {locale}
        </span>

        <!-- ChevronDown Icon -->
        <svg
          aria-hidden="true"
          id="language-dropdown-chevron"
          class="w-3.5 h-3.5 text-zinc-400 transition-transform duration-200 shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.25"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m6 9 6 6 6-6" />
        </svg>
      </button>

      <!-- Dropdown Popover & Menu -->
      <div
        id="language-dropdown-popover"
        role="listbox"
        aria-label={t.nav.languageLabel}
        class="hidden absolute right-0 mt-1.5 w-52 origin-top-right rounded-xl border border-zinc-200/90 bg-white/98 backdrop-blur-md p-1 shadow-lg shadow-zinc-950/5 ring-1 ring-black/5 focus:outline-none z-50"
      >
        <div class="px-2.5 py-1.5 text-[10px] font-mono font-medium text-zinc-400 tracking-wider uppercase border-b border-zinc-100 mb-1">
          {t.nav.languageLabel}
        </div>
        <div class="space-y-0.5 max-h-72 overflow-y-auto">
          {
            LOCALES.map((loc) => {
              const targetUrl = switchLocalePath(currentPath, loc);
              const meta = LOCALE_METADATA[loc];
              const isSelected = loc === locale;
              return (
                <a
                  href={targetUrl}
                  role="option"
                  aria-selected={isSelected ? "true" : "false"}
                  data-locale={loc}
                  class={`flex items-center justify-between w-full px-2.5 py-1.5 rounded-lg text-xs transition-colors cursor-pointer select-none ${
                    isSelected
                      ? 'bg-zinc-100 text-zinc-950 font-semibold'
                      : 'text-zinc-600 hover:text-zinc-950 hover:bg-zinc-50'
                  }`}
                >
                  <div class="flex items-center gap-2">
                    <span class="inline-flex items-center justify-center w-6 h-5 rounded text-[10px] font-mono font-bold tracking-wider uppercase bg-zinc-100 text-zinc-700">
                      {loc}
                    </span>
                    <span class="font-sans text-xs">{meta.nativeName}</span>
                  </div>
                  {isSelected && (
                    <svg
                      aria-hidden="true"
                      class="w-3.5 h-3.5 text-zinc-950 shrink-0"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.25"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                  )}
                </a>
              );
            })
          }
        </div>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const root = document.getElementById('language-dropdown-root');
    const trigger = document.getElementById('language-dropdown-trigger');
    const popover = document.getElementById('language-dropdown-popover');
    const chevron = document.getElementById('language-dropdown-chevron');
    if (!root || !trigger || !popover) return;

    function openMenu() {
      popover.classList.remove('hidden');
      trigger.setAttribute('aria-expanded', 'true');
      if (chevron) chevron.classList.add('rotate-180');
    }

    function closeMenu() {
      popover.classList.add('hidden');
      trigger.setAttribute('aria-expanded', 'false');
      if (chevron) chevron.classList.remove('rotate-180');
    }

    function toggleMenu() {
      const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeMenu();
      } else {
        openMenu();
      }
    }

    trigger.addEventListener('click', function (e) {
      e.stopPropagation();
      toggleMenu();
    });

    document.addEventListener('click', function (e) {
      if (!root.contains(e.target)) {
        closeMenu();
      }
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        closeMenu();
        trigger.focus();
      }
    });

    const options = popover.querySelectorAll('a[data-locale]');
    options.forEach(function (option) {
      option.addEventListener('click', function () {
        const loc = option.getAttribute('data-locale');
        if (loc) {
          try {
            localStorage.setItem('preferred_locale', loc);
          } catch (_) {}
        }
      });
    });
  })();
</script>
