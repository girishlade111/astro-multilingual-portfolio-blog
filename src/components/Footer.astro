---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getTranslations, type Locale } from '../i18n/config';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const homeUrl = getRelativeLocaleUrl(locale, '');
const blogUrl = getRelativeLocaleUrl(locale, 'blog');
const currentYear = 2024;
const brandDisplay = t.brandName.replace(/\.+$/, '');
---

<footer class="border-t border-zinc-200/70 bg-[#fafafa] dark:border-zinc-800/80 dark:bg-[#09090b] transition-colors duration-150 mt-auto">
  <div class="max-w-3xl mx-auto px-3.5 sm:px-6 py-6 sm:py-7 flex flex-col sm:flex-row items-center justify-between gap-4">
    <!-- Left: Brand & Copyright -->
    <div class="flex items-center gap-2 sm:gap-2.5 text-xs text-zinc-500 flex-wrap sm:flex-nowrap justify-center sm:justify-start">
      <a
        href={homeUrl}
        class="font-display inline-flex items-center text-xs sm:text-sm font-bold tracking-tight text-zinc-950 hover:text-zinc-700 dark:text-zinc-100 dark:hover:text-zinc-300 transition-colors whitespace-nowrap"
      >
        {brandDisplay}
      </a>
      <span aria-hidden="true" class="w-1 h-1 rounded-full bg-zinc-300 dark:bg-zinc-700 shrink-0"></span>
      <span class="inline-flex items-center text-xs text-zinc-500 dark:text-zinc-400 whitespace-nowrap">
        © {currentYear} {t.footer.rights}
      </span>
    </div>

    <!-- Center & Right: Compact Nav + Social Icons -->
    <div class="flex items-center gap-3 sm:gap-4">
      <nav
        aria-label="Footer Navigation"
        class="flex items-center gap-3 sm:gap-4 text-xs font-medium text-zinc-500 dark:text-zinc-400"
      >
        <a
          href={homeUrl}
          class="inline-flex items-center h-8 px-1 hover:text-zinc-950 dark:hover:text-white transition-colors whitespace-nowrap"
        >
          {t.nav.home}
        </a>
        <a
          href={blogUrl}
          class="inline-flex items-center h-8 px-1 hover:text-zinc-950 dark:hover:text-white transition-colors whitespace-nowrap"
        >
          {t.nav.blog}
        </a>
      </nav>

      <span aria-hidden="true" class="h-3.5 w-px bg-zinc-200/90 dark:bg-zinc-800 shrink-0"></span>

      <div class="flex items-center gap-1" aria-label="Social Links">
        <!-- GitHub Official Minimal Mark -->
        <a
          href="https://github.com/girishlade111"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-zinc-500 hover:text-zinc-950 hover:bg-zinc-200/50 dark:text-zinc-400 dark:hover:text-white dark:hover:bg-zinc-800 transition-colors"
        >
          <svg
            aria-hidden="true"
            class="w-4 h-4"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z"
            />
          </svg>
        </a>

        <!-- Instagram Official Minimal Icon -->
        <a
          href="https://www.instagram.com/girish_lade_/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-zinc-500 hover:text-zinc-950 hover:bg-zinc-200/50 dark:text-zinc-400 dark:hover:text-white dark:hover:bg-zinc-800 transition-colors"
        >
          <svg
            aria-hidden="true"
            class="w-4 h-4"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path
              d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069ZM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0Zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324ZM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881Z"
            />
          </svg>
        </a>

        <!-- LinkedIn Official Minimal Icon -->
        <a
          href="https://www.linkedin.com/in/girish-lade/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-zinc-500 hover:text-zinc-950 hover:bg-zinc-200/50 dark:text-zinc-400 dark:hover:text-white dark:hover:bg-zinc-800 transition-colors"
        >
          <svg
            aria-hidden="true"
            class="w-4 h-4"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path
              d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77Z"
            />
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
