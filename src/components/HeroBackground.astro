---
/**
 * Responsive Botanical Frame Hero Background
 * Uses the botanical reference assets:
 * - Light theme: /assets/aistudio/image_a475d35f.webp (bright studio floral frame)
 * - Dark theme: /assets/aistudio/image_dark_botanical_clean.webp (nocturnal moonlight floral frame)
 * Optimizes framing for both portrait mobile screens and wide desktop viewports
 * while keeping the center behind the 3D Lanyard clean, seamless, and watermark-free.
 */
interface Props {
  imageUrl?: string;
  darkImageUrl?: string;
}

const {
  imageUrl = '/assets/aistudio/image_a475d35f.webp',
  darkImageUrl = '/assets/aistudio/image_dark_botanical_clean.webp',
} = Astro.props;
---

<div
  id="lanyard-hero-background"
  data-testid="lanyard-hero-background"
  aria-hidden="true"
  class="pointer-events-none absolute inset-x-0 top-1.5 bottom-1.5 z-0 overflow-hidden rounded-2xl border border-zinc-200/80 bg-[#f4f5f6] shadow-2xs dark:border-zinc-800/80 dark:bg-[#0c0c0e] dark:shadow-black/50 transition-colors duration-150"
>
  <!-- Desktop & Tablet Botanical Frame (sm and up): Full 4-side frame with seamless center blend -->
  <div class="hidden sm:block absolute inset-0">
    <!-- Light Theme Botanical Frame -->
    <div
      class="dark:hidden absolute inset-0 bg-cover bg-center bg-no-repeat scale-[1.01]"
      style={`background-image: url('${imageUrl}');`}
    />
    <!-- Light Theme Center Radial Blend -->
    <div
      class="dark:hidden absolute inset-0"
      style="background: radial-gradient(ellipse 46% 34% at 50% 50%, #f4f5f6 0%, #f4f5f6 60%, rgba(244, 245, 246, 0.82) 76%, rgba(244, 245, 246, 0) 100%);"
    />

    <!-- Dark Theme Nocturnal Botanical Frame (Created specifically for dark theme) -->
    <div
      class="hidden dark:block absolute inset-0 bg-cover bg-center bg-no-repeat scale-[1.01]"
      style={`background-image: url('${darkImageUrl}');`}
    />
    <!-- Dark Theme Center Radial Blend (seamlessly matches the #0c0c0e center of darkImageUrl) -->
    <div
      class="hidden dark:block absolute inset-0"
      style="background: radial-gradient(ellipse 46% 34% at 50% 50%, #0c0c0e 0%, #0c0c0e 55%, rgba(12, 12, 14, 0.72) 75%, rgba(12, 12, 14, 0) 100%);"
    />
    <!-- Dark Theme Subtle Moonlight Ambient Highlight -->
    <div
      class="hidden dark:block absolute inset-0"
      style="background: radial-gradient(circle at 50% 12%, rgba(255, 255, 255, 0.025) 0%, transparent 65%);"
    />
  </div>

  <!-- Mobile Portrait Botanical Frame (< 640px): Dual edge-anchored layers so left & right botanicals frame the hero cleanly -->
  <div class="block sm:hidden absolute inset-0">
    <!-- Light Theme Mobile Edges -->
    <div
      class="dark:hidden absolute inset-y-0 left-0 w-[64%] bg-cover bg-left bg-no-repeat"
      style={`background-image: url('${imageUrl}'); -webkit-mask-image: linear-gradient(to right, #000 0%, #000 54%, transparent 100%); mask-image: linear-gradient(to right, #000 0%, #000 54%, transparent 100%);`}
    />
    <div
      class="dark:hidden absolute inset-y-0 right-0 w-[64%] bg-cover bg-right bg-no-repeat"
      style={`background-image: url('${imageUrl}'); -webkit-mask-image: linear-gradient(to left, #000 0%, #000 54%, transparent 100%); mask-image: linear-gradient(to left, #000 0%, #000 54%, transparent 100%);`}
    />
    <!-- Light Theme Center Vertical Studio Blend -->
    <div
      class="dark:hidden absolute inset-0"
      style="background: radial-gradient(ellipse 50% 44% at 50% 50%, #f4f5f6 0%, #f4f5f6 62%, rgba(244, 245, 246, 0.85) 78%, rgba(244, 245, 246, 0) 100%);"
    />

    <!-- Dark Theme Mobile Edges -->
    <div
      class="hidden dark:block absolute inset-y-0 left-0 w-[64%] bg-cover bg-left bg-no-repeat"
      style={`background-image: url('${darkImageUrl}'); -webkit-mask-image: linear-gradient(to right, #000 0%, #000 54%, transparent 100%); mask-image: linear-gradient(to right, #000 0%, #000 54%, transparent 100%);`}
    />
    <div
      class="hidden dark:block absolute inset-y-0 right-0 w-[64%] bg-cover bg-right bg-no-repeat"
      style={`background-image: url('${darkImageUrl}'); -webkit-mask-image: linear-gradient(to left, #000 0%, #000 54%, transparent 100%); mask-image: linear-gradient(to left, #000 0%, #000 54%, transparent 100%);`}
    />
    <!-- Dark Theme Center Vertical Blend -->
    <div
      class="hidden dark:block absolute inset-0"
      style="background: radial-gradient(ellipse 50% 44% at 50% 50%, #0c0c0e 0%, #0c0c0e 60%, rgba(12, 12, 14, 0.75) 78%, rgba(12, 12, 14, 0) 100%);"
    />
  </div>

  <!-- Subtle inner studio vignette & bottom caption scrim for clean typography contrast -->
  <div
    class="absolute inset-x-0 bottom-0 h-12 bg-gradient-to-t from-[#f4f5f6]/90 via-[#f4f5f6]/45 to-transparent dark:from-[#0c0c0e]/95 dark:via-[#0c0c0e]/50 dark:to-transparent transition-colors duration-150"
  />
  <div class="absolute inset-0 rounded-2xl ring-1 ring-inset ring-black/[0.04] dark:ring-white/[0.06]" />
</div>
