---
import '../styles/global.css';
import { LOCALES, DEFAULT_LOCALE, UI_TRANSLATIONS, BROWSER_LOCALE_MAP } from '../i18n/config';

const t = UI_TRANSLATIONS[DEFAULT_LOCALE];
const supportedList = JSON.stringify(LOCALES);
const localeMapJson = JSON.stringify(BROWSER_LOCALE_MAP);
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Native OS Status Bar Colors (Immediate Mobile C++ Engine Level Coloring) -->
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fafafa" id="meta-theme-color" />

    <!-- Immediate Zero-Flash Theme Initialization based on Dual Storage (localStorage + Cookie) -->
    <script is:inline>
      (function () {
        try {
          function getCookie(name) {
            var match = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]*)'));
            return match ? decodeURIComponent(match[1]) : null;
          }
          var stored = null;
          try {
            stored = localStorage.getItem('theme');
          } catch (_) {}
          if (!stored) {
            stored = getCookie('theme');
          }
          var mql = window.matchMedia ? window.matchMedia('(prefers-color-scheme: dark)') : null;
          var isDark = stored === 'dark' || (!stored && mql && mql.matches);
          if (isDark) {
            document.documentElement.classList.add('dark');
            document.documentElement.setAttribute('data-theme', 'dark');
          } else {
            document.documentElement.classList.remove('dark');
            document.documentElement.setAttribute('data-theme', 'light');
          }
          var metaTheme = document.getElementById('meta-theme-color');
          if (metaTheme) metaTheme.setAttribute('content', isDark ? '#09090b' : '#fafafa');
        } catch (_) {}
      })();
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />

    <!-- Microsoft Clarity -->
    <script type="text/javascript" is:inline>
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "z8g8pciia9");
    </script>
    <script is:inline>
      (function () {
        try {
          const desc = Object.getOwnPropertyDescriptor(window, 'fetch') || Object.getOwnPropertyDescriptor(Window.prototype, 'fetch');
          if (desc && desc.get && !desc.set && desc.configurable !== false) {
            let currentFetch = window.fetch.bind(window);
            Object.defineProperty(window, 'fetch', {
              configurable: true,
              enumerable: true,
              get: function () {
                return currentFetch;
              },
              set: function (fn) {
                if (typeof fn === 'function') currentFetch = fn;
              },
            });
          }
        } catch (_) {}
      })();
    </script>
    <title>{t.siteTitle}</title>
    <meta name="description" content={t.siteDescription} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="text/markdown" href="/llms.txt" title="LLMs.txt" />
    <link rel="help" type="text/markdown" href="/llms.txt" />
    <link rel="agent-catalog" type="application/json" href="/ai-catalog.json" />
    <link rel="canonical" href={`/${DEFAULT_LOCALE}/`} />

    <!-- Fallback for JavaScript-disabled crawlers and environments -->
    <noscript>
      <meta http-equiv="refresh" content={`0;url=/${DEFAULT_LOCALE}/`} />
    </noscript>

    <!-- Immediate Smart Locale Router (Dual Storage -> System / Browser Language -> Fallback) -->
    <script is:inline define:vars={{ supportedList, defaultLocale: DEFAULT_LOCALE, localeMapJson }}>
      (function () {
        try {
          var allowed = JSON.parse(supportedList);
          var langMap = JSON.parse(localeMapJson);
          var target = defaultLocale;

          function getCookie(name) {
            var match = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]*)'));
            return match ? decodeURIComponent(match[1]) : null;
          }

          // Priority 1: User's manual selection from Dual Storage (localStorage OR Cookie)
          var saved = null;
          try {
            saved = localStorage.getItem('preferred_locale');
          } catch (_) {}
          if (!saved) {
            saved = getCookie('preferred_locale');
          }

          if (saved && allowed.indexOf(saved) !== -1) {
            target = saved;
          } else {
            // Priority 2: System / Browser preference (First visit or new device)
            var userLangs = [];
            if (navigator.languages && navigator.languages.length) {
              userLangs = navigator.languages;
            } else if (navigator.language) {
              userLangs = [navigator.language];
            } else if (navigator.userLanguage) { // Legacy Edge/IE/Mobile WebViews
              userLangs = [navigator.userLanguage];
            } else if (navigator.browserLanguage) {
              userLangs = [navigator.browserLanguage];
            }

            for (var i = 0; i < userLangs.length; i++) {
              if (!userLangs[i]) continue;
              var raw = String(userLangs[i]).toLowerCase().trim();
              var primary = raw.split(/[-_]/)[0];
              var candidate = langMap[raw] || langMap[primary];
              if (candidate && allowed.indexOf(candidate) !== -1) {
                target = candidate;
                break;
              }
            }
          }

          // Anchor choice into Dual Storage
          try {
            localStorage.setItem('preferred_locale', target);
            document.cookie = 'preferred_locale=' + encodeURIComponent(target) + ';path=/;max-age=31536000;SameSite=Lax';
          } catch (_) {}

          var search = window.location.search || '';
          var hash = window.location.hash || '';
          window.location.replace('/' + target + '/' + search + hash);
        } catch (_) {
          window.location.replace('/' + defaultLocale + '/');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex items-center justify-center bg-[#fafafa] text-zinc-900 dark:bg-[#09090b] dark:text-zinc-100 px-6">
    <div class="text-center space-y-3">
      <p class="text-sm text-zinc-500 dark:text-zinc-400">Redirecting to localized portfolio...</p>
      <a
        href={`/${DEFAULT_LOCALE}/`}
        class="inline-flex items-center gap-2 text-xs font-medium text-zinc-900 dark:text-zinc-100 underline underline-offset-4"
      >
        Continue to /{DEFAULT_LOCALE}/
      </a>
    </div>
  </body>
</html>
