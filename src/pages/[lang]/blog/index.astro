---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  LOCALES,
  resolveLocale,
  getTranslations,
  type Locale,
} from '../../../i18n/config';
import { getSearchableBlogsByLocale } from '../../../utils/blog';
import BlogDirectory from '../../../components/BlogDirectory';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({
    params: { lang },
  }));
}

const activeLocale = Astro.currentLocale || Astro.params.lang;
const locale: Locale = resolveLocale(activeLocale);
const t = getTranslations(locale);
const searchablePosts = getSearchableBlogsByLocale(locale);
const currentPath = getRelativeLocaleUrl(locale, 'blog');
---

<BaseLayout
  locale={locale}
  title={t.blog.title}
  description={t.blog.subtitle}
  currentPath={currentPath}
>
  <div class="py-10 sm:py-20 space-y-10 sm:space-y-12">
    <!-- Blog Page Header -->
    <header class="pb-8 sm:pb-10 border-b border-zinc-200/80 space-y-3 max-w-2xl">
      <div class="flex flex-wrap items-center gap-2 text-xs text-zinc-500 font-mono">
        <span>{t.blog.allPostsLabel}</span>
        <span aria-hidden="true">/</span>
        <span>{t.blog.markdownBadge}</span>
        <span aria-hidden="true">/</span>
        <span>/{locale}/blog</span>
      </div>
      <h1 class="font-display text-2xl sm:text-4xl font-semibold tracking-tight text-zinc-950">
        {t.blog.title}
      </h1>
      <p class="text-sm sm:text-base text-zinc-600 leading-relaxed">
        {t.blog.subtitle}
      </p>
    </header>

    <!-- Interactive Search, Filter & Paginated List Island -->
    <BlogDirectory client:idle posts={searchablePosts} strings={t.blog} locale={locale} />
  </div>
</BaseLayout>
