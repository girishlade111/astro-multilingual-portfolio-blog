---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  LOCALES,
  resolveLocale,
  getTranslations,
  type Locale,
} from '../../../i18n/config';
import { getBlogsByLocale } from '../../../utils/blog';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({
    params: { lang },
  }));
}

const activeLocale = Astro.currentLocale || Astro.params.lang;
const locale: Locale = resolveLocale(activeLocale);
const t = getTranslations(locale);
const posts = getBlogsByLocale(locale);
const currentPath = getRelativeLocaleUrl(locale, 'blog');
---

<BaseLayout
  locale={locale}
  title={t.blog.title}
  description={t.blog.subtitle}
  currentPath={currentPath}
>
  <div class="py-10 sm:py-20 space-y-10 sm:space-y-12">
    <!-- Blog Page Header -->
    <header class="pb-8 sm:pb-10 border-b border-zinc-200/80 space-y-3 max-w-2xl">
      <div class="flex flex-wrap items-center gap-2 text-xs text-zinc-500 font-mono">
        <span>{t.blog.allPostsLabel}</span>
        <span aria-hidden="true">·</span>
        <span>{t.blog.markdownBadge}</span>
        <span aria-hidden="true">·</span>
        <span>/{locale}/blog</span>
      </div>
      <h1 class="font-display text-2xl sm:text-4xl font-semibold tracking-tight text-zinc-950">
        {t.blog.title}
      </h1>
      <p class="text-sm sm:text-base text-zinc-600 leading-relaxed">
        {t.blog.subtitle}
      </p>
    </header>

    <!-- Markdown Blog List -->
    <section aria-label={t.blog.allPostsLabel} class="divide-y divide-zinc-200/80">
      {
        posts.map((post) => {
          const postUrl = getRelativeLocaleUrl(
            locale,
            `blog/${post.frontmatter.slug}`
          );
          return (
            <article class="py-7 sm:py-8 first:pt-0 last:pb-0 group">
              <div class="space-y-3 max-w-3xl">
                <div class="flex flex-wrap items-center gap-2 text-xs text-zinc-500 font-mono">
                  <span>{post.frontmatter.category}</span>
                  <span aria-hidden="true">·</span>
                  <span>
                    {t.blog.publishedOn} {post.frontmatter.pubDate}
                  </span>
                  <span aria-hidden="true">·</span>
                  <span>
                    {post.frontmatter.readingTime} {t.blog.readingTime}
                  </span>
                </div>

                <h2 class="font-display text-lg sm:text-2xl font-semibold tracking-tight text-zinc-950 group-hover:text-zinc-700 transition-colors">
                  <a href={postUrl} class="focus:outline-none block py-0.5">
                    {post.frontmatter.title}
                  </a>
                </h2>

                <p class="text-sm sm:text-base text-zinc-600 leading-relaxed">
                  {post.frontmatter.description}
                </p>

                <div class="pt-1">
                  <a
                    href={postUrl}
                    class="inline-flex items-center gap-1.5 min-h-[40px] text-xs font-semibold text-zinc-900 hover:text-zinc-600 transition-colors whitespace-nowrap"
                  >
                    <span>{t.blog.readArticle}</span>
                    <svg
                      aria-hidden="true"
                      class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M7 17 17 7" />
                      <path d="M7 7h10v10" />
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          );
        })
      }
    </section>
  </div>
</BaseLayout>
