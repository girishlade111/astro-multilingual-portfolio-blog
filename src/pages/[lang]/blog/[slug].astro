---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  resolveLocale,
  getTranslations,
  type Locale,
} from '../../../i18n/config';
import {
  getAllLocaleBlogPaths,
  type BlogMarkdownModule,
} from '../../../utils/blog';

export function getStaticPaths() {
  return getAllLocaleBlogPaths();
}

interface Props {
  post: BlogMarkdownModule;
}

const { slug } = Astro.params;
const activeLocale = Astro.currentLocale || Astro.params.lang;
const locale: Locale = resolveLocale(activeLocale);
const t = getTranslations(locale);
const { post } = Astro.props;
const { Content } = post;
const headings = post.getHeadings().filter((h) => h.depth === 2 || h.depth === 3);

const currentPath = getRelativeLocaleUrl(locale, `blog/${slug}`);
const blogIndexUrl = getRelativeLocaleUrl(locale, 'blog');
---

<BaseLayout
  locale={locale}
  title={post.frontmatter.title}
  description={post.frontmatter.description}
  currentPath={currentPath}
  pageType="article"
  publishedTime={post.frontmatter.pubDate}
>
  <!-- Reading Progress Bar (Scroll Tracker) -->
  <div
    id="reading-progress-bar"
    aria-hidden="true"
    class="fixed top-0 left-0 right-0 h-[2.5px] bg-zinc-950 dark:bg-zinc-100 z-50 origin-left scale-x-0 transition-transform duration-75"
  ></div>

  <div class="py-8 sm:py-16">
    <!-- Back to Blog Link -->
    <div class="mb-6 sm:mb-8">
      <a
        href={blogIndexUrl}
        class="inline-flex items-center gap-2 min-h-[40px] text-xs font-medium text-zinc-500 hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-white transition-colors whitespace-nowrap"
      >
        <svg
          aria-hidden="true"
          class="w-3.5 h-3.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M19 12H5" />
          <path d="m11 18-6-6 6-6" />
        </svg>
        <span>{t.blog.backToBlog}</span>
      </a>
    </div>

    <!-- Article Header & Content -->
    <article class="space-y-8 sm:space-y-10">
      <header class="pb-6 sm:pb-8 border-b border-zinc-200/80 dark:border-zinc-800/80 space-y-4 w-full">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex flex-wrap items-center gap-2 text-xs text-zinc-500 dark:text-zinc-400 font-mono">
            <span>{post.frontmatter.category}</span>
            <span aria-hidden="true">·</span>
            <span>
              {t.blog.publishedOn} {post.frontmatter.pubDate}
            </span>
            <span aria-hidden="true">·</span>
            <span>
              {post.frontmatter.readingTime} {t.blog.readingTime}
            </span>
          </div>

          <button
            type="button"
            id="copy-article-link"
            data-copy-label={t.blog.copyLink}
            data-copied-label={t.blog.copiedLink}
            class="inline-flex items-center gap-1.5 min-h-[36px] px-3 py-1.5 text-xs font-medium text-zinc-700 bg-white border border-zinc-200 hover:border-zinc-400 dark:text-zinc-300 dark:bg-zinc-900 dark:border-zinc-800 dark:hover:border-zinc-700 rounded-lg transition-colors cursor-pointer whitespace-nowrap shrink-0"
          >
            <svg
              aria-hidden="true"
              class="w-3.5 h-3.5 text-zinc-500"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect width="12" height="12" x="9" y="9" rx="2" />
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
            </svg>
            <span id="copy-article-link-text">{t.blog.copyLink}</span>
          </button>
        </div>

        <h1 class="font-display text-2xl sm:text-4xl font-semibold tracking-tight text-zinc-950 dark:text-white leading-tight max-w-3xl">
          {post.frontmatter.title}
        </h1>

        <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400 leading-relaxed max-w-3xl">
          {post.frontmatter.description}
        </p>
      </header>

      <!-- Main Article Content & Responsive Table of Contents -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        <!-- Compiled HTML from Markdown (.md -> HTML) -->
        <div class="lg:col-span-8 markdown-prose w-full overflow-hidden">
          <Content />
        </div>

        <!-- Minimal Table of Contents Sidebar -->
        {
          headings.length > 0 && (
            <aside
              aria-label={t.blog.tableOfContents}
              class="lg:col-span-4 lg:sticky lg:top-24 max-h-[calc(100vh-7rem)] overflow-y-auto p-4 sm:p-5 rounded-xl bg-white border border-zinc-200/80 space-y-3 order-first lg:order-last dark:bg-[#121214] dark:border-zinc-800 shadow-2xs"
            >
              <h2 class="font-display text-xs font-semibold text-zinc-900 dark:text-zinc-100 tracking-tight">
                {t.blog.tableOfContents}
              </h2>
              <ul class="space-y-2 text-xs text-zinc-600 dark:text-zinc-400">
                {headings.map((h) => (
                  <li class={h.depth === 3 ? 'pl-3' : ''}>
                    <a
                      href={`#${h.slug}`}
                      class="toc-link hover:text-zinc-950 dark:hover:text-white transition-colors block py-0.5 leading-snug"
                      data-heading={h.slug}
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </aside>
          )
        }
      </div>
    </article>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    // 1. Article Link Share Copy
    const copyBtn = document.getElementById('copy-article-link');
    const copyText = document.getElementById('copy-article-link-text');
    if (copyBtn && copyText) {
      copyBtn.addEventListener('click', async function () {
        const copiedLabel = copyBtn.getAttribute('data-copied-label') || 'Copied';
        const defaultLabel = copyBtn.getAttribute('data-copy-label') || 'Copy link';
        try {
          await navigator.clipboard.writeText(window.location.href);
        } catch (_) {}
        copyText.textContent = copiedLabel;
        setTimeout(function () {
          copyText.textContent = defaultLabel;
        }, 2000);
      });
    }

    // 2. Reading Progress Calculation
    const progressBar = document.getElementById('reading-progress-bar');
    const articleEl = document.querySelector('article');
    if (progressBar && articleEl) {
      let ticking = false;
      function updateProgress() {
        const rect = articleEl.getBoundingClientRect();
        const totalHeight = rect.height - window.innerHeight;
        if (totalHeight <= 0) {
          progressBar.style.transform = 'scaleX(1)';
          return;
        }
        const scrolled = Math.max(0, -rect.top);
        const progress = Math.min(1, Math.max(0, scrolled / totalHeight));
        progressBar.style.transform = 'scaleX(' + progress + ')';
        ticking = false;
      }

      window.addEventListener('scroll', function () {
        if (!ticking) {
          window.requestAnimationFrame(updateProgress);
          ticking = true;
        }
      }, { passive: true });
      updateProgress();
    }

    // 3. Code Block Copy Button & Language Badge Enhancer
    const codeBlocks = document.querySelectorAll('.markdown-prose pre');
    codeBlocks.forEach(function (pre) {
      if (pre.closest('.code-block-wrapper')) return;

      const wrapper = document.createElement('div');
      wrapper.className = 'code-block-wrapper relative group my-6 rounded-xl overflow-hidden border border-zinc-800 bg-[#121214] text-zinc-100 shadow-sm';

      const header = document.createElement('div');
      header.className = 'flex items-center justify-between px-4 py-2 border-b border-zinc-800/80 bg-zinc-900/90 text-xs text-zinc-400 font-mono select-none';

      const codeEl = pre.querySelector('code');
      const langClass = (codeEl?.className || pre.className || '').match(/language-([a-z0-9_-]+)/i);
      const lang = langClass ? langClass[1].toUpperCase() : 'CODE';

      const langBadge = document.createElement('span');
      langBadge.className = 'font-semibold tracking-wider text-[11px] text-zinc-400';
      langBadge.textContent = lang;

      const copyBtn = document.createElement('button');
      copyBtn.type = 'button';
      copyBtn.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[11px] font-medium text-zinc-300 hover:text-white bg-zinc-800 hover:bg-zinc-700 transition-colors cursor-pointer';
      copyBtn.innerHTML = '<svg class="w-3.5 h-3.5 text-zinc-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="12" height="12" x="9" y="9" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg><span>Copy</span>';

      copyBtn.addEventListener('click', async function () {
        const text = codeEl ? codeEl.innerText : pre.innerText;
        try {
          await navigator.clipboard.writeText(text);
          copyBtn.innerHTML = '<svg class="w-3.5 h-3.5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg><span class="text-emerald-400 font-medium">Copied!</span>';
          setTimeout(function () {
            copyBtn.innerHTML = '<svg class="w-3.5 h-3.5 text-zinc-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="12" height="12" x="9" y="9" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg><span>Copy</span>';
          }, 2000);
        } catch (_) {}
      });

      header.appendChild(langBadge);
      header.appendChild(copyBtn);

      pre.parentNode.insertBefore(wrapper, pre);
      wrapper.appendChild(header);
      wrapper.appendChild(pre);
      pre.classList.add('p-4', 'overflow-x-auto', 'text-sm', 'leading-relaxed', 'm-0', 'bg-transparent');
    });

    // 4. Active Heading Spy for Sticky "On this page" TOC
    const tocLinks = document.querySelectorAll('.toc-link');
    const headingEls = Array.from(document.querySelectorAll('.markdown-prose :is(h2, h3)'));
    if (tocLinks.length > 0 && headingEls.length > 0) {
      function highlightToc() {
        const scrollY = window.scrollY;
        let currentSlug = '';
        for (let i = 0; i < headingEls.length; i++) {
          const el = headingEls[i];
          const top = el.offsetTop - 120;
          if (scrollY >= top) {
            currentSlug = el.id;
          } else {
            break;
          }
        }
        if (!currentSlug && headingEls[0]) {
          currentSlug = headingEls[0].id;
        }
        tocLinks.forEach(function (link) {
          if (link.getAttribute('data-heading') === currentSlug) {
            link.classList.add('active-toc-item');
          } else {
            link.classList.remove('active-toc-item');
          }
        });
      }

      window.addEventListener('scroll', highlightToc, { passive: true });
      highlightToc();
    }
  })();
</script>
