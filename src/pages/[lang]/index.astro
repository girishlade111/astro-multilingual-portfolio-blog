---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroBackground from '../../components/HeroBackground.astro';
import Lanyard from '../../components/LanyardDeferred';
import PortfolioSections from '../../components/PortfolioSections';
import {
  LOCALES,
  resolveLocale,
  type Locale,
} from '../../i18n/config';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({
    params: { lang },
  }));
}

const activeLocale = Astro.currentLocale || Astro.params.lang;
const locale: Locale = resolveLocale(activeLocale);
const currentPath = getRelativeLocaleUrl(locale, '');

const profileImageUrl = '/assets/aistudio/profile_34f4dafb.webp';
const heroBackgroundImageUrl = '/assets/aistudio/image_a475d35f.webp';
---

<BaseLayout
  locale={locale}
  title="Girish Lade — UI/UX Designer, Full-Stack Developer & LadeStack Founder"
  description="Explore the portfolio of Girish Balaso Lade, a UI/UX designer and full-stack developer creating privacy-conscious developer tools, web apps, and LadeStack products."
  currentPath={currentPath}
>
  <div id="homepage-wrapper" class="relative w-full">
    <!-- Reserved Clean Hero Section Exclusively for the 3D Lanyard Component -->
    <section
      id="lanyard-hero-slot"
      aria-label="Interactive 3D Lanyard Hero"
      class="relative z-30 w-full h-[380px] sm:h-[440px] lg:h-[480px] flex flex-col items-center justify-end select-none overflow-visible"
    >
      <!-- Responsive Botanical Hero Background (Mobile & Desktop optimized) -->
      <HeroBackground imageUrl={heroBackgroundImageUrl} />

      <!-- Instant 0ms SSR Lanyard Preview (renders immediately with HTML and pre-decodes the profile image for WebGL Frame 1) -->
      <div
        id="lanyard-ssr-preview"
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 z-20 flex flex-col items-center justify-start overflow-hidden transition-opacity duration-150"
      >
        <!-- Black Woven Lanyard Strap -->
        <div
          class="w-[21px] sm:w-[24px] lg:w-[26px] h-[54px] sm:h-[64px] lg:h-[70px] bg-[#141416] shadow-xs"
          style="background-image: repeating-linear-gradient(0deg, rgba(255,255,255,0.04) 0px, rgba(255,255,255,0.04) 1px, transparent 1px, transparent 3px);"
        />
        <!-- Metallic Silver Clamp -->
        <div class="w-[25px] sm:w-[29px] lg:w-[31px] h-[12px] sm:h-[14px] rounded-[3px] bg-gradient-to-b from-[#e4e7ec] via-[#cfd4dc] to-[#9ea4b0] border border-zinc-500/40 shadow-2xs -mt-[1px]" />
        <!-- Metallic Ring -->
        <div class="w-[14px] sm:w-[16px] h-[14px] sm:h-[16px] rounded-full border-[2.5px] border-[#c8cdd6] shadow-2xs -mt-[3px] z-10" />
        <!-- Portrait ID Card with Pre-Decoded Profile Image -->
        <div class="relative -mt-[7px] w-[140px] h-[197px] sm:w-[162px] sm:h-[228px] lg:w-[178px] lg:h-[250px] rounded-[14px] sm:rounded-[16px] bg-white shadow-[0_10px_28px_rgba(0,0,0,0.16)] ring-1 ring-black/10 overflow-hidden">
          <img
            id="lanyard-preload-profile"
            data-lanyard-src={profileImageUrl}
            src={profileImageUrl}
            alt=""
            width="400"
            height="602"
            fetchpriority="high"
            loading="eager"
            decoding="sync"
            class="w-full h-full object-cover select-none"
          />
          <!-- Card Top Slot Punch Hole -->
          <div class="absolute top-[7px] sm:top-[8px] left-1/2 -translate-x-1/2 w-[30px] sm:w-[34px] h-[6px] sm:h-[7px] rounded-full bg-[#f4f5f6] shadow-inner ring-1 ring-black/15" />
        </div>
      </div>

      <!-- 3D Lanyard Canvas Stage anchored in Hero and extending over sections below when stretched -->
      <div
        id="lanyard-canvas-stage"
        class="pointer-events-none absolute top-0 left-0 right-0 h-[780px] sm:h-[880px] lg:h-[940px] z-30 overflow-visible"
      >
        <Lanyard
          client:idle
          frontImage={profileImageUrl}
          backImage={profileImageUrl}
          imageFit="cover"
          cardColor="#ffffff"
          orientation="portrait"
          finish="glossy"
          cornerRadius={0.28}
          size={0.52}
          anchor="center"
          strapLength={0.35}
          strapColor="#111111"
          strapWidth={0.65}
          metal="silver"
          gravity={1}
          damping={0.5}
          elasticity={0.5}
          breeze={0.5}
          gyroscope={true}
          gyroSensitivity={0.55}
          heroSelector="#lanyard-hero-slot"
          interactive={true}
          intro={true}
        />
      </div>

      <!-- Name plate: sits directly under the hanging card -->
      <div class="pointer-events-none absolute left-1/2 -translate-x-1/2 bottom-[46px] sm:bottom-[48px] lg:bottom-[52px] z-20">
        <p
          id="hero-name"
          class="hero-name text-[28px] sm:text-[32px] lg:text-[36px] font-semibold leading-none text-zinc-950 whitespace-nowrap select-none"
        >
          Girish Lade
        </p>
      </div>
    </section>

    <!-- Portfolio Master Content (Hydrates on idle so 3D Lanyard gets 100% initial load priority) -->
    <PortfolioSections client:idle locale={locale} />
  </div>
</BaseLayout>

<style>
  /* Name plate motion & luxury editorial typography: driven by custom properties set from the lanyard card
     position. Amplitude stays small so the text reads as calm, not animated. */
  .hero-name {
    font-family: 'Cormorant Garamond', 'Playfair Display', Didot, 'Bodoni MT', Georgia, serif;
    letter-spacing: -0.01em;
    text-shadow: 0 1px 2px rgba(255, 255, 255, 0.9), 0 2px 12px rgba(0, 0, 0, 0.04);
    transform: translate3d(var(--hero-name-x, 0px), var(--hero-name-y, 0px), 0)
      rotate(var(--hero-name-rot, 0deg));
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-name {
      transform: none;
      will-change: auto;
    }
  }
</style>

<script>
  // Follows the lanyard card with a few pixels of lag. Lanyard already publishes
  // data-card-x / data-card-y on its container every rendered frame, so this
  // script only reads them and never touches the 3D component.
  const hero = document.getElementById('lanyard-hero-slot');
  const name = document.getElementById('hero-name');

  if (hero && name) {
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

    const MAX_X = 7; // px
    const MAX_Y = 5; // px
    const MAX_TILT = 2.2; // deg
    const RANGE_X = 3; // card travel that maps to full amplitude (world units)
    const RANGE_Y = 3.5;
    const VEL_X = 22; // px per world unit of per-frame card motion
    const VEL_Y = 12;
    const TILT_VEL = 6; // deg per world unit of per-frame card motion
    const STIFF = 0.11; // spring pull toward the card
    const DAMP = 0.85; // keeps a little overshoot, like the card's elastic
    const BASELINE_EASE = 0.006; // slow recentre so drift does not accumulate

    let container: HTMLElement | null = null;
    let raf = 0;
    let baseX = 0;
    let baseY = 0;
    let prevX = 0;
    let prevY = 0;
    let primed = false;
    let x = 0;
    let y = 0;
    let rot = 0;
    let velX = 0;
    let velY = 0;
    let velRot = 0;

    const clamp = (value: number, min: number, max: number) =>
      value < min ? min : value > max ? max : value;

    const write = () => {
      name.style.setProperty('--hero-name-x', `${x.toFixed(2)}px`);
      name.style.setProperty('--hero-name-y', `${y.toFixed(2)}px`);
      name.style.setProperty('--hero-name-rot', `${rot.toFixed(2)}deg`);
    };

    const frame = () => {
      raf = requestAnimationFrame(frame);

      if (!container) {
        container = document.querySelector<HTMLElement>('[data-testid="lanyard-3d"]');
        if (!container) return;
      }

      const rawX = Number.parseFloat(container.getAttribute('data-card-x') ?? '');
      const rawY = Number.parseFloat(container.getAttribute('data-card-y') ?? '');
      if (!Number.isFinite(rawX) || !Number.isFinite(rawY)) return;

      if (!primed) {
        baseX = prevX = rawX;
        baseY = prevY = rawY;
        primed = true;
        return;
      }

      // Card speed this frame: the name inherits it so a flick carries the text.
      const cardVX = clamp(rawX - prevX, -0.5, 0.5);
      const cardVY = clamp(rawY - prevY, -0.8, 0.8);
      prevX = rawX;
      prevY = rawY;

      baseX += (rawX - baseX) * BASELINE_EASE;
      baseY += (rawY - baseY) * BASELINE_EASE;

      const dx = clamp((rawX - baseX) / RANGE_X, -1, 1);
      const dy = clamp((rawY - baseY) / RANGE_Y, -1, 1);

      const targetX = clamp(dx * MAX_X + cardVX * VEL_X, -9, 9);
      const targetY = clamp(-dy * MAX_Y - cardVY * VEL_Y, -6, 6);
      const targetRot = clamp(dx * MAX_TILT + cardVX * TILT_VEL, -2.8, 2.8);

      // Damped spring, one axis at a time, so the text trails and settles
      // instead of snapping to the card position.
      velX = (velX + (targetX - x) * STIFF) * DAMP;
      velY = (velY + (targetY - y) * STIFF) * DAMP;
      velRot = (velRot + (targetRot - rot) * STIFF) * DAMP;

      x = clamp(x + velX, -10, 10);
      y = clamp(y + velY, -7, 7);
      rot = clamp(rot + velRot, -3, 3);

      write();
    };

    const stop = () => {
      if (!raf) return;
      cancelAnimationFrame(raf);
      raf = 0;
      primed = false;
      velX = velY = velRot = 0;
    };

    const start = () => {
      if (raf || motionQuery.matches || document.hidden) return;
      raf = requestAnimationFrame(frame);
    };

    const onReady = () => {
      if (hero.getAttribute('data-lanyard-ready') === 'true') start();
    };

    const readyObserver = new MutationObserver(onReady);
    readyObserver.observe(hero, { attributes: true, attributeFilter: ['data-lanyard-ready'] });
    onReady();

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else onReady();
    });

    motionQuery.addEventListener('change', () => {
      if (motionQuery.matches) {
        stop();
        x = y = rot = 0;
        velX = velY = velRot = 0;
        write();
      } else {
        onReady();
      }
    });
  }
</script>
